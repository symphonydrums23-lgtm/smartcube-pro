# SmartCube - .env v2 - corrigido
# NUNCA commita esse arquivo. Ele está no .dockerignore e no .gitignore.

# --- LOGIN ---
# Mantido: seu usuário
SMARTCUBE_USER=admin
# CORRIGIDO: troca por senha nova, forte, gerada abaixo. A antiga vazou aqui.
SMARTCUBE_ADMIN_PASS=GERE_UMA_NOVA_AQUI_32_CARACTERES

# --- JWT ---
# CORRIGIDO: antes "troque-isso-depois" - se subir assim, qualquer um forja token de admin
# Gera com o comando abaixo, 64 caracteres
SECRET_JWT=GERE_UM_TOKEN_NOVO_AQUI_64_CARACTERES
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# CORRIGIDO: faltava - antes o token nunca expirava, roubou 1 vez, usa pra sempre
JWT_REFRESH_EXPIRE_DAYS=7

# --- BANCO ---
# Mantido: mesmo host, mesma porta, mesmo banco
# CORRIGIDO: senha do banco separada da senha do admin, antes era parecida
DATABASE_URL=postgresql://postgres:GERE_SENHA_BANCO_AQUI@db:5432/smartcube
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GERE_SENHA_BANCO_AQUI
POSTGRES_DB=smartcube

# --- APP ---
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
# CORRIGIDO: faltava - sem isso o CORS ficava liberado pra qualquer site
CORS_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1:8000

# --- AUDITORIA ---
# CORRIGIDO: faltava - caminho dos logs que o Dockerfile cria
AUDIT_LOG_PATH=/app/logs/auditoria.json
DATA_PATH=/app/data
